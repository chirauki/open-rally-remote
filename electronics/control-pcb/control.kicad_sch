(label "BAT" (at 114.30 210.82 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "636a229c-5a75-5025-a97a-85b5ed94d0fa"))
(text "Power: USB-C VBUS_IN -> F1 -> VBUS (D1 clamps) -> U1 MCP73831 charger, 100 mA (R1).\nBattery: J5 -> Q1 (reverse polarity) -> BAT_SYS -> U2 TPS70933 -> +3V3 -> XIAO 3V3 pin.\nSense: BAT_SYS / 2 -> D0 (A0); STAT x 2/3 -> D8 (high when charging is done); VBUS x 2/3 -> D9.\nSTAT also sinks the charge LED on the USB-C board (J3 pin 3), lit only while charging.\nXIAO headers J1 (D0-D6) and J2 (5V, GND, 3V3, D10, D9, D8, D7); 5V and D10 open." (exclude_from_sim no) (at 30.48 220.98 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ef8bbf8d-af04-57d9-91ab-85123a40a582"))
(sheet_instances (path "/" (page "1")))
(embedded_fonts no)
)
